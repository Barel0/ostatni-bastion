<?xml version="1.0" encoding="utf-8"?>
<!-- Gra działa bez internetu. Uprawnienie INTERNET służy tylko publicznemu rankingowi (demo/online.js);
     wyniki są wysyłane wyłącznie za zgodą gracza. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="pl.maniacdev.ostatnibastion">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:isGame="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
